{
  "name": "LastMileDelivery",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "bash scripts/with-nvm.sh react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "prestart": "bash scripts/setup-packager.sh && bash scripts/patch-metro-node21.sh",
    "start": "bash scripts/with-nvm.sh react-native start",
    "preandroid": "bash scripts/setup-packager.sh && bash scripts/patch-metro-node21.sh",
    "test": "jest",
    "clean": "cd android && ./gradlew clean",
    "release": "cd android && ./gradlew assembleRelease",
    "postinstall": "patch-package && bash scripts/patch-metro-node21.sh && bash scripts/setup-packager.sh"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "axios": "^1.20.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.26.2",
    "react-native-uuid": "^2.0.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20 <22"
  }
}
