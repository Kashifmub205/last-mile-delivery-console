{
  "templateId": "tpl-commercial",
  "name": "Commercial delivery",
  "fields": [
    {
      "id": "signatory_name",
      "type": "TEXT",
      "label": "Signatory name",
      "isRequired": true
    },
    {
      "id": "handover_time",
      "type": "DATETIME",
      "label": "Handover time",
      "isRequired": true
    },
    {
      "id": "delivery_notes",
